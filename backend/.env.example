APP_NAME="Pentagon Insight Flow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pentagon_insight_flow
DB_USERNAME=pentagon_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=pentagon_insight_session
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Local development only: reset links are written to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Pentagon Insight Flow"


DOCUMENT_PYTHON=../.tools/python/python.exe
DOCUMENT_PROCESSOR_SCRIPT=../document-processor/processor.py
DOCUMENT_QUEUE=documents
DOCUMENT_MAX_FILE_MB=25
DOCUMENT_MAX_BATCH=10
DOCUMENT_MAX_TOTAL_MB=100
DOCUMENT_TIMEOUT=900
DOCUMENT_OCR_ENGINE=auto
DB_QUEUE_RETRY_AFTER=1200
# SQLite local concurrency (ignored by MySQL connections).
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_TRANSACTION_MODE=IMMEDIATE
# Stage 6 private PDF renderer (run npm ci in backend/pdf-renderer)
PDF_NODE_BINARY=node
# Leave unset to use Playwright's managed Chromium on Linux.
PDF_CHROMIUM_PATH=
PDF_TIMEOUT=180
PDF_DRAFT_RETENTION_DAYS=30

# Recoverable Trash; records are never purged automatically. Minimum 1 day.
TRASH_RETENTION_DAYS=30
