# Production example only. Copy to a private backend/.env and replace every blank/placeholder.
APP_NAME="Pentagon Insight Flow"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://reports.your-domain.invalid
FRONTEND_URL=https://reports.your-domain.invalid
SANCTUM_STATEFUL_DOMAINS=reports.your-domain.invalid
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_COOKIE=pentagon_insight_session
SESSION_LIFETIME=120
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pentagon_production
DB_USERNAME=pentagon_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1200
REDIS_QUEUE_RETRY_AFTER=1200
CACHE_STORE=database
FILESYSTEM_DISK=local
LOCAL_PRIVATE_ROOT=/srv/pentagon/shared/private
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Pentagon Insight Flow"
DOCUMENT_PYTHON=/srv/pentagon/shared/venv/bin/python
DOCUMENT_PROCESSOR_SCRIPT=../document-processor/processor.py
DOCUMENT_QUEUE=documents
DOCUMENT_TIMEOUT=900
DOCUMENT_MAX_FILE_MB=25
DOCUMENT_MAX_BATCH=10
DOCUMENT_MAX_TOTAL_MB=100
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_CELLS=250000
DOCUMENT_MAX_EXPANDED_MB=100
DOCUMENT_MAX_OUTPUT_MB=32
DOCUMENT_OCR_ENGINE=tesseract
DOCUMENT_TESSERACT=/usr/bin/tesseract
PDF_NODE_BINARY=/usr/bin/node
PDF_CHROMIUM_PATH=
PDF_TIMEOUT=180
PDF_DRAFT_RETENTION_DAYS=30
# Service user's Playwright browser location; also set in the supervisor environment.
PLAYWRIGHT_BROWSERS_PATH=/srv/pentagon/shared/ms-playwright
