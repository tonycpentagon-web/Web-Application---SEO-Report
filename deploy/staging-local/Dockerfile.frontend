FROM node:22-bookworm-slim AS build
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
ENV VITE_API_URL=""
RUN npm run build
FROM nginx:stable-alpine
RUN apk add --no-cache openssl && mkdir -p /etc/nginx/stage8 && openssl req -x509 -newkey rsa:2048 -nodes -keyout /etc/nginx/stage8/local.key -out /etc/nginx/stage8/local.crt -days 30 -subj /CN=localhost -addext subjectAltName=DNS:localhost,IP:127.0.0.1
COPY --from=build /build/dist /usr/share/nginx/html
COPY deploy/staging-local/nginx.conf /etc/nginx/conf.d/default.conf
